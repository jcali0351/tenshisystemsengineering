{#- HERO: the big opening section. data-edit marks words you can click and type over in the page builder. -#}
{% set b = block.data %}
<section class="hero hero-{{ b.layout or 'split' }}"{% if b.layout == 'background' and b.image %} style="--hero-img: url('{{ media(b.image, 1600) }}')"{% endif %}>
  <div class="wrap hero-in">
    <div class="hero-text">
      {% if b.kicker %}<p class="kicker" data-edit="kicker">{{ b.kicker }}</p>{% endif %}
      <h1 data-edit="heading">{{ b.heading or company.tagline or company.name }}</h1>
      <p class="lead" data-edit="text">{{ b.text or company.description }}</p>
      <div class="actions">
        {% if b.button_text %}<a class="btn" href="{{ link(b.button_link or 'contact') }}" data-edit="button_text">{{ b.button_text }}</a>{% endif %}
        {% if b.call_button and company.phone %}<a class="btn btn-line" href="tel:{{ company.phone | tel }}">Call {{ company.phone }}</a>{% endif %}
      </div>
    </div>
    {% if b.image and b.layout != 'background' %}
    <figure class="hero-pic"><img src="{{ media(b.image, 1600) }}" alt="{{ media_alt(b.image) }}"></figure>
    {% endif %}
  </div>
</section>
