{#- TEXT: a heading and a few paragraphs. body is simple HTML (paragraphs, bold, links, lists), cleaned by the CMS. -#}
{% set b = block.data %}
<section class="band text-block{% if b.center %} center{% endif %}">
  <div class="wrap narrow">
    {% if b.heading %}<h2 data-edit="heading">{{ b.heading }}</h2>{% endif %}
    <div class="prose" data-edit="body" data-rich>{{ b.body | clean_html }}</div>
  </div>
</section>
