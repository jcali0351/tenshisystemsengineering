{#- CONTACT DETAILS: phone, email, address, hours and every location from the profile. -#}
{% set b = block.data %}
<section class="band contact-block">
  <div class="wrap">
    <h2 data-edit="heading">{{ b.heading or 'Contact us' }}</h2>
    <div class="cards cards-3">
      <div class="card">
        <h3>Get in touch</h3>
        {% if company.phone %}<p><a href="tel:{{ company.phone | tel }}">{{ company.phone }}</a></p>{% endif %}
        {% if company.email %}<p><a href="mailto:{{ company.email }}">{{ company.email }}</a></p>{% endif %}
        {% if company.address %}<p>{{ company.address }}</p>{% endif %}
      </div>
      {% if company.hours %}
      <div class="card"><h3>Hours</h3>{% for h in company.hours %}<p><b>{{ h.days }}</b> {{ h.time }}</p>{% endfor %}</div>
      {% endif %}
      {%- for place in locations %}
      <div class="card">
        <h3>{{ place.name }}</h3>
        {% if place.address %}<p>{{ place.address }}</p>{% endif %}
        {% if place.phone %}<p><a href="tel:{{ place.phone | tel }}">{{ place.phone }}</a></p>{% endif %}
        {% if place.address %}<p><a href="https://www.openstreetmap.org/search?query={{ place.address | urlencode }}" rel="noopener">Open map</a></p>{% endif %}
      </div>
      {%- endfor %}
    </div>
  </div>
</section>
